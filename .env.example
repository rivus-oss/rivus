TZ=UTC

MYSQL_ROOT_PASS=rivus-root-pass
RIVUS_META_MYSQL_DATABASE=rivus_meta
RIVUS_META_MYSQL_USER=rivus
RIVUS_META_MYSQL_PASSWORD=change-me
RIVUS_META_MYSQL_DSN=rivus:change-me@tcp(meta-mysql:3306)/rivus_meta?parseTime=true
RIVUS_META_MYSQL_PORT=43306

RIVUS_HTTP_PORT=8080
RIVUS_API_TOKEN=
RIVUS_IMAGE_TAG=latest
RIVUS_AUTO_RESUME=false
RIVUS_SHUTDOWN_TIMEOUT_SECONDS=90
RIVUS_STOP_GRACE_PERIOD=2m

RIVUS_UI_LOGIN_ENABLED=false
RIVUS_UI_LOGIN_USERNAME=admin
RIVUS_UI_LOGIN_PASSWORD=change-me
RIVUS_UI_SESSION_SECRET=change-me

# One shared log root, separated by runtime role.
RIVUS_LOG_ROOT=/app/logs
RIVUS_MASTER_LOG_DIR=/app/logs/master
RIVUS_STREAMING_LOG_DIR=/app/logs/streaming
RIVUS_SNAPSHOT_LOG_DIR=/app/logs/snapshot
RIVUS_MAINTENANCE_LOG_DIR=/app/logs/maintenance
# Maximum tables discovered per monitor across matching catalogs (including
# streaming/snapshot reservations). Increase to 50000 for larger installations.
RIVUS_MAINTENANCE_MAX_DISCOVERED_TABLES=10000
RIVUS_LOG_RETENTION_DAYS=7
RIVUS_LOG_MAX_SIZE_MB=64
RIVUS_LOG_MAX_TOTAL_SIZE_MB=2048
# Keep high-volume CDC logs in Rivus rotating files instead of Docker stderr.
RIVUS_LOG_STDERR=false

RIVUS_ICEBERG_MAX_CONCURRENT_COMMITS=3

ICEBERG_REST_URI=http://iceberg-rest:8181
ICEBERG_WAREHOUSE=warehouse
ICEBERG_REST_AUTH_HEADER=
ICEBERG_REST_BASIC_USERNAME=
ICEBERG_REST_BASIC_PASSWORD=
ICEBERG_S3_ENDPOINT=http://minio:9000
ICEBERG_S3_PATH_STYLE=true
# Blank: auto-enable for custom/non-AWS endpoints. Set false to opt out.
ICEBERG_S3_COMPAT_MODE=
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_DEFAULT_REGION=us-east-1
